{
  "name": "@aszenz/data-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "prettier --check . && tsc --noEmit && eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "vitest": "vitest",
    "preview": "vite preview --port 3000",
    "start": "npm run build && npm run preview"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev45.0",
    "@malloydata/db-duckdb": "^0.0.403",
    "@malloydata/malloy": "^0.0.403",
    "@malloydata/malloy-explorer": "^0.0.338-dev260215172810",
    "@malloydata/malloy-interfaces": "^0.0.403",
    "@malloydata/malloy-query-builder": "^0.0.403",
    "@malloydata/render": "^0.0.403",
    "@malloydata/syntax-highlight": "^0.0.403",
    "@shikijs/core": "^4.1.0",
    "@shikijs/engine-javascript": "^4.1.0",
    "@shikijs/themes": "^4.1.0",
    "monaco-editor-core": "^0.55.1",
    "picomatch": "^4.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@malloydata/cli": "^0.0.55",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@malloydata/db-duckdb": {
      "@duckdb/duckdb-wasm": "$@duckdb/duckdb-wasm"
    }
  }
}
