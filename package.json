{
  "name": "@aszenz/data-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "prettier --check . && tsc --noEmit && eslint .",
    "format": "prettier --write .",
    "test": "playwright test",
    "vitest": "vitest",
    "preview": "vite preview --port 3000",
    "start": "npm run build && npm run preview"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@malloydata/db-duckdb": "^0.0.420",
    "@malloydata/malloy": "^0.0.420",
    "@malloydata/malloy-explorer": "^0.0.338-dev260215172810",
    "@malloydata/malloy-interfaces": "^0.0.420",
    "@malloydata/malloy-query-builder": "^0.0.420",
    "@malloydata/render": "^0.0.420",
    "@malloydata/syntax-highlight": "^0.0.420",
    "@shikijs/core": "^4.3.0",
    "@shikijs/engine-javascript": "^4.3.0",
    "@shikijs/themes": "^4.3.0",
    "monaco-editor-core": "^0.55.1",
    "picomatch": "^4.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@malloydata/cli": "^0.0.56",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "playwright": "1.61.1",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@malloydata/db-duckdb": {
      "@duckdb/duckdb-wasm": "$@duckdb/duckdb-wasm"
    }
  }
}
